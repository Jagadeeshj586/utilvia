NEXT_PUBLIC_SITE_URL=https://utilvia.net

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Loaded via @next/third-parties/google in src/app/layout.tsx — do not paste the
# gtag.js snippet into the site or the tag will fire twice.
# Set this in Vercel Production for https://utilvia.net, then redeploy.
NEXT_PUBLIC_GA_ID=

# Background Remover
# Default engine is on-device IS-Net via @imgly/background-removal (no API key).
# BACKGROUND_REMOVAL_PROVIDER=imgly|clipdrop|removebg|auto
# BACKGROUND_REMOVAL_MODEL=isnet_fp16|isnet|isnet_quint8
# NEXT_PUBLIC_BACKGROUND_REMOVAL_PROVIDER=imgly
# NEXT_PUBLIC_BACKGROUND_REMOVAL_MODEL=isnet_fp16
# NEXT_PUBLIC_BACKGROUND_REMOVAL_DEVICE=cpu # cpu | gpu
# Optional cloud fallback / primary (server-only — never expose to the browser):
# BACKGROUND_REMOVAL_API_KEY=
